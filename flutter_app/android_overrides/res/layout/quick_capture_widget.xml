<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/capture_widget_background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/capture_widget_title"
        android:textColor="@color/capture_ink"
        android:textSize="20sp"
        android:fontFamily="serif"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/capture_note"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/capture_note"
            android:textAllCaps="false"
            android:textColor="@color/capture_button_text"
            android:backgroundTint="@color/capture_accent" />
        <Button
            android:id="@+id/capture_checklist"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/capture_checklist"
            android:textAllCaps="false"
            android:textColor="@color/capture_button_text"
            android:backgroundTint="@color/capture_accent" />
    </LinearLayout>
</LinearLayout>
